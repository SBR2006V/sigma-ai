generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  domain        String
  status        AgentStatus   @default(ACTIVE)
  initializedAt DateTime?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastRunStatus String?
  activityLogs  ActivityLog[]
  runs          AgentRun[]
  memories      Memory[]
  posts         Post[]
  topics        Topic[]

  @@index([status])
  @@index([nextRunAt])
}

model Topic {
  id             String        @id @default(uuid()) @db.Uuid
  agentId        String        @db.Uuid
  canonicalKey   String
  title          String
  summary        String?
  url            String
  sourceName     String
  sourceType     String?
  category       String?
  tags           Json?
  publishedAt    DateTime?
  discoveredAt   DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  editorialScore Int?
  status         TopicStatus   @default(DISCOVERED)
  decisionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  activityLogs   ActivityLog[]
  memories       Memory[]
  posts          Post[]
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, canonicalKey])
  @@index([agentId, status])
  @@index([agentId, editorialScore])
  @@index([publishedAt])
  @@index([lastSeenAt])
}

model Post {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @db.Uuid
  topicId     String?  @db.Uuid
  text        String
  rationale   String
  sources     Json
  createdAt   DateTime @default(now())
  title       String?
  whyNow      String?
  whySelected String?
  memories    Memory[]
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  topic       Topic?   @relation(fields: [topicId], references: [id])

  @@index([agentId, createdAt])
  @@index([topicId])
}

model Memory {
  id               String         @id @default(uuid()) @db.Uuid
  agentId          String         @db.Uuid
  topicId          String?        @db.Uuid
  postId           String?        @db.Uuid
  tier             MemoryTier
  topicKey         String
  summary          String
  importantPoints  Json?
  keywords         Json?
  editorialOpinion String?
  fullPost         String?
  sources          Json?
  lastSeenAt       DateTime
  lastPublishedAt  DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  compactedAt      DateTime?
  decision         MemoryDecision @default(PUBLISHED)
  entities         String[]       @default([])
  entitiesRaw      Json?
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  post             Post?          @relation(fields: [postId], references: [id])
  topic            Topic?         @relation(fields: [topicId], references: [id])

  @@index([agentId, topicKey])
  @@index([agentId, tier])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@index([decision, expiresAt])
  @@index([entities], type: Gin)
}

model ActivityLog {
  id        String       @id @default(uuid()) @db.Uuid
  agentId   String       @db.Uuid
  topicId   String?      @db.Uuid
  type      ActivityType
  message   String
  score     Int?
  metadata  Json?
  createdAt DateTime     @default(now())
  runId     String?      @db.Uuid
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  run       AgentRun?    @relation(fields: [runId], references: [id])
  topic     Topic?       @relation(fields: [topicId], references: [id])

  @@index([agentId, createdAt])
  @@index([agentId, type])
  @@index([runId])
}

model AgentRun {
  id               String        @id @default(uuid()) @db.Uuid
  agentId          String        @db.Uuid
  status           RunStatus     @default(RUNNING)
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  topicsDiscovered Int           @default(0)
  topicsRejected   Int           @default(0)
  topicsHeld       Int           @default(0)
  topicsPublished  Int           @default(0)
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  activityLogs     ActivityLog[]
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startedAt])
  @@index([agentId, status])
}

model WorkerLease {
  id             String    @id @default("singleton")
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
}

model KnownEntity {
  id            String   @id @default(uuid()) @db.Uuid
  canonicalName String   @unique
  aliases       String[] @default([])
  category      String?
  createdAt     DateTime @default(now())
}

enum AgentStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum TopicStatus {
  DISCOVERED
  HELD
  REJECTED
  SKIPPED
  PUBLISHED
}

enum MemoryTier {
  SHORT_TERM
  LONG_TERM
}

enum MemoryDecision {
  PUBLISHED
  PUBLISHED_DEFERRED
  REJECTED
}

enum ActivityType {
  AGENT_INITIALIZED
  DISCOVERY_STARTED
  DISCOVERY_COMPLETED
  TOPIC_DISCOVERED
  TOPIC_REJECTED
  TOPIC_HELD
  TOPIC_SKIPPED
  TOPIC_SELECTED
  POST_GENERATED
  POST_PUBLISHED
  MEMORY_CREATED
  MEMORY_UPDATED
  RUN_COMPLETED
  RUN_FAILED
}
